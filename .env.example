# Copy to .env and fill locally. Existing shell/container variables take priority.
GITHUB_TOKEN=
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://api.openai.com/v1

# Repository scan limits. Restart the service after changing these values.
SCAN_MAX_DOWNLOAD_MB=200
SCAN_MAX_EXPANDED_MB=512
SCAN_MAX_ENTRIES=100000
SCAN_MAX_FILES=20000
SCAN_MAX_FILE_MB=2
SCAN_TIMEOUT_SECONDS=300
